{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker serves both the API (Hono, /api/*) and the React app (Static Assets built from apps/web).
  "name": "ai-daily",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Client-side routes (/day/…, /search, /archive, /me) get index.html from the SPA fallback.
    // The Worker (Hono) runs first for:
    //   /api, /api/*  -> unknown API paths still answer the JSON 404/405, never the SPA shell
    //   /*.*          -> file-like URLs: existing files are served, missing ones get a real 404 (+ /favicon.ico -> 204)
    //   /day/*        -> 200 shell for an existing report, 404 otherwise; /trend, /fav -> 301 (src/routes/pages.ts)
    //   /story/*      -> 200 shell + og tags for an existing story, 404 page (no og tags) otherwise
    //   /og/day/*, /og/story/* -> share cards from KV (CARDS) or the default image /og/default-*.png (src/routes/og.ts)
    //   Day/story shells get their og tags injected with HTMLRewriter; /og/default-*.png stay static.
    //   /assets, /assets/* -> content-hashed build files: existing ones are returned as-is (with the 1-year cache from
    //                    _headers), missing ones get 404 + no-store instead of the SPA shell (docs/adr/0002)
    //   /, /search, /archive, /me -> SPA shell + og tags (PRD #26: crawlers do not run JS); HTML cached <= 5 min
    // `/?d=` is still redirected by the front end (PRD #26 allows the first request to be 200).
    // /theme.js and /brand/* are served straight from the asset layer (no Worker invocation; they always exist).
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/search",
      "/archive",
      "/me",
      "/api",
      "/api/*",
      "/day/*",
      "/story/*",
      "/og/day/*",
      "/og/story/*",
      "/trend",
      "/fav",
      "/assets",
      "/assets/*",
      "/*.*",
      "!/theme.js",
      "!/brand/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-daily",
      // filled in by scripts/deploy.sh after `wrangler d1 create ai-daily`
      "database_id": "2cca5d7c-7b42-444a-9503-1bfab4be128a",
      "migrations_dir": "../../migrations",
    },
  ],
  // Pre-rendered share cards (PNG), written by scripts/prerender-cards.mjs, read by the Worker.
  "kv_namespaces": [{ "binding": "CARDS", "id": "82bd75f2a1c840efaec59f49ee9764dd" }],
  "vars": { "FAVORITES_MAX": "2000" },
  // Preview environment: `wrangler deploy -c apps/api/wrangler.jsonc --env preview` (or `pnpm deploy:preview`).
  // Deploys a separate Worker named `ai-daily-preview` with its own D1, so PRs can be checked on a real URL
  // without touching production. d1_databases, kv_namespaces and vars are not inherited by envs, so they are repeated here.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ai-daily-preview",
          "database_id": "542c4f6c-f324-4e3f-bd2f-7882d993cb89",
          "migrations_dir": "../../migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "CARDS", "id": "aa99993895c94d0b9fde304efc5ed0d3" }],
      "vars": { "FAVORITES_MAX": "2000" },
    },
  },
}
