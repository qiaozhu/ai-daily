{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-daily",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-daily",
      // filled in by scripts/deploy.sh after `wrangler d1 create ai-daily`
      "database_id": "2cca5d7c-7b42-444a-9503-1bfab4be128a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "FAVORITES_MAX": "2000" }
}
